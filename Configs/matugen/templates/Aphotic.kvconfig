[%General]
author=Aphotic
comment=Aphotic dynamic Qt theme, colors generated by matugen, widget art from Kvantum's bundled KvArcDark theme
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=1
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=6
splitter_width=6
scroll_width=12
scroll_min_extent=48
slider_width=10
slider_handle_length=20
check_size=17
tickless_slider_handle_size=8
groove_thickness=3
animate_states=true

[GeneralColors]
window.color={{colors.surface.default.hex_stripped}}
base.color={{colors.surface.default.hex_stripped}}
text.color={{colors.on_surface.default.hex_stripped}}
window.text.color={{colors.on_surface.default.hex_stripped}}
button.color={{colors.surface_container_lowest.default.hex_stripped}}
button.text.color={{colors.on_surface.default.hex_stripped}}
highlight.color={{colors.primary.default.hex_stripped}}
highlight.text.color={{colors.surface.default.hex_stripped}}
tooltip.text.color={{colors.on_surface.default.hex_stripped}}
tooltip.color={{colors.surface_container_lowest.default.hex_stripped}}
progress.indicator.text.color={{colors.on_surface.default.hex_stripped}}
link.color={{colors.primary.default.hex_stripped}}
link.visited.color={{colors.primary_fixed_dim.default.hex_stripped}}

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
kcapacitybar_as_progressbar=true
lxqtmainmenu_iconsize=true
respect_darkness=true
