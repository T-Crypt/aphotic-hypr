# noctis restore manifest
# format: <path-relative-to-NOCTIS_DOTS_DIR>|<absolute-target-path>
# ~ is expanded to $HOME. Lines starting with # are comments.
#
# Fill this in as the real dots repo layout solidifies — this is a
# starting skeleton, not a final list.

hypr/hyprland.conf|~/.config/hypr/hyprland.conf
hypr/hyprland/monitors.conf|~/.config/hypr/hyprland/monitors.conf
hypr/hyprland/keybindings.conf|~/.config/hypr/hyprland/keybindings.conf
quickshell/noctis|~/.config/quickshell/noctis
noctis/shell.json|~/.config/noctis/shell.json
