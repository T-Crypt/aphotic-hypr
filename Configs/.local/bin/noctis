#!/usr/bin/env bash
# noctis — Noctis CLI dispatcher
# @name: noctis
# @short: Noctis dotfiles & shell control
# @ver: 0.1.0
# @usage: noctis <command> [args]
#
# Modeled on hyde-shell's dispatch/discovery pattern and caelestia's IPC
# verbs. Each subcommand lives in its own file under lib/noctis/commands/
# as cmd_<name>.sh and defines a single function noctis_cmd_<name>().
# Adding a command = adding a file. This dispatcher should not need edits
# for new subcommands, only for new top-level aliases.

set -euo pipefail

# ---------------------------------------------------------------------
# Resolve BIN_DIR / LIB_DIR relative to this script's real location, so
# `noctis` works whether it's symlinked onto PATH from ~/.local/bin or
# run straight out of a cloned repo.
# ---------------------------------------------------------------------
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    EXECUTABLE="${BASH_SOURCE[0]}"
else
    EXECUTABLE="$0"
fi
BIN_DIR="$(cd "$(dirname "$(readlink -f "$EXECUTABLE")")" && pwd)"
LIB_DIR="$(cd "${BIN_DIR}/../lib/noctis" && pwd)"
COMMANDS_DIR="${LIB_DIR}/commands"
export BIN_DIR LIB_DIR COMMANDS_DIR

# ---------------------------------------------------------------------
# Shared env + helper functions (logging, XDG paths, confirm prompts).
# ---------------------------------------------------------------------
if [[ -r "${LIB_DIR}/globalcontrol.sh" ]]; then
    # shellcheck source=/dev/null
    source "${LIB_DIR}/globalcontrol.sh"
else
    echo "noctis: cannot find ${LIB_DIR}/globalcontrol.sh — broken install?" >&2
    exit 1
fi

_noctis_list_commands() {
    [[ -d "$COMMANDS_DIR" ]] || return 0
    find "$COMMANDS_DIR" -maxdepth 1 -type f -name 'cmd_*.sh' -exec basename {} \; \
        | sed -e 's/^cmd_//' -e 's/\.sh$//' \
        | sort
}

# Built entirely from each command file's `@cmd`/`@cmd.desc`/`@cmd.group`
# header annotations (see commands/README.md) — adding a command file
# with those annotations is enough to show up here correctly grouped,
# no edits to this dispatcher required. `@cmd.group` is optional; an
# ungrouped command lands under OTHER rather than being silently
# dropped from the list.
_noctis_usage() {
    local _R=$'\e[0m' _B=$'\e[1m' _D=$'\e[2m' _C=$'\e[36m'
    local group_order=(CORE CONFIG LIFECYCLE AI BUILD FUN)
    local -A group_lines=()
    local file name desc group line ncmds=0

    for file in "$COMMANDS_DIR"/cmd_*.sh; do
        [[ -f "$file" ]] || continue
        ncmds=$((ncmds + 1))
        name="$(sed -n 's/^# @cmd: *//p' "$file" | head -n1)"
        [[ -n "$name" ]] || name="$(basename "$file" .sh | sed 's/^cmd_//')"
        desc="$(sed -n 's/^# @cmd\.desc: *//p' "$file" | head -n1)"
        group="$(sed -n 's/^# @cmd\.group: *//p' "$file" | head -n1)"
        [[ -n "$group" ]] || group="OTHER"

        line="$(printf '    %s%-12s%s %s' "$_C" "$name" "$_R" "$desc")"
        if [[ -z "${group_lines[$group]:-}" ]]; then
            group_lines[$group]="$line"
        else
            group_lines[$group]+=$'\n'"$line"
        fi
    done

    printf '\n%snoctis%s %sv%s%s — Noctis dotfiles & shell control\n\n' "$_B" "$_R" "$_D" "$NOCTIS_VERSION" "$_R"
    printf '%sUSAGE%s\n    noctis %s<command>%s %s[args]%s\n\n' "$_B" "$_R" "$_C" "$_R" "$_D" "$_R"

    local g
    for g in "${group_order[@]}"; do
        [[ -n "${group_lines[$g]:-}" ]] || continue
        printf '%s%s%s\n%s\n\n' "$_B" "$g" "$_R" "${group_lines[$g]}"
        unset 'group_lines[$g]'
    done
    for g in "${!group_lines[@]}"; do
        printf '%s%s%s\n%s\n\n' "$_B" "$g" "$_R" "${group_lines[$g]}"
    done

    printf 'Run %snoctis <command> --help%s for details on a specific command.\n' "$_C" "$_R"
    printf '%s%s command(s) discovered in %s%s\n\n' "$_D" "$ncmds" "$COMMANDS_DIR" "$_R"
}

_noctis_dispatch() {
    local cmd="$1"; shift || true
    local script="${COMMANDS_DIR}/cmd_${cmd}.sh"
    if [[ -r "$script" ]]; then
        # shellcheck source=/dev/null
        source "$script"
        local fn="noctis_cmd_${cmd}"
        if declare -F "$fn" >/dev/null; then
            "$fn" "$@"
        else
            noctis_err "cmd_${cmd}.sh does not define ${fn}() — see lib/noctis/commands/README.md"
            exit 1
        fi
    else
        noctis_err "unknown command '${cmd}'"
        echo "Run 'noctis --help' to see available commands." >&2
        exit 127
    fi
}

case "${1:-}" in
    ""|-h|--help|help)
        _noctis_usage
        ;;
    -v|--version|version)
        echo "noctis ${NOCTIS_VERSION}"
        ;;
    -s|commands)
        _noctis_list_commands
        ;;
    *)
        cmd="$1"; shift
        _noctis_dispatch "$cmd" "$@"
        ;;
esac
