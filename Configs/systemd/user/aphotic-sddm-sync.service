[Unit]
Description=Sync the SDDM login background to the active desktop wallpaper

[Service]
Type=oneshot
# Absolute path, not `/usr/bin/env aphotic` -- see aphotic-agent-usage.
# service's own comment for why (systemd --user's PATH doesn't include
# ~/.local/bin, so `env` can never resolve the plain name).
ExecStart=%h/.local/bin/aphotic sddm sync
