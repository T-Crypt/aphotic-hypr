[%General]
author=Aphotic
comment=Aphotic dynamic Qt theme, colors generated by wallust, widget art from Kvantum's bundled KvArcDark theme
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=1
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=6
splitter_width=6
scroll_width=12
scroll_min_extent=48
slider_width=10
slider_handle_length=20
check_size=17
tickless_slider_handle_size=8
groove_thickness=3
animate_states=true

[GeneralColors]
window.color={background.strip}
base.color={background.strip}
text.color={foreground.strip}
window.text.color={foreground.strip}
button.color={color0.strip}
button.text.color={foreground.strip}
highlight.color={color4.strip}
highlight.text.color={background.strip}
tooltip.text.color={foreground.strip}
tooltip.color={color0.strip}
progress.indicator.text.color={foreground.strip}
link.color={color4.strip}
link.visited.color={color5.strip}

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
kcapacitybar_as_progressbar=true
lxqtmainmenu_iconsize=true
respect_darkness=true
