# Agent working docs - not part of the shipped rice
docs/
CLAUDE.md
AGENTS.md
.superpowers/
.claude/

aphotic.toml
install.log

# ~/.config/wallust symlinks here, so everything that writes a colorscheme
# at runtime lands in the working tree: the palette clamp's *-live.json
# (themes/THEME_SPEC.md's "Clamped palettes"), a downloaded theme's own
# scheme, and the Theme Creator's. Only the per-theme anchors are ours.
Configs/wallust/colorschemes/*.json
!Configs/wallust/colorschemes/*-anchor.json
__pycache__/
.DS_Store
Thumbs.db
*.swp
*.bak

# Compiled shaders. Built from the .frag sources at install time against
# whatever Qt the machine has, never committed.
*.qsb

recordings/

# Local agent-tooling state: retrieval indexes over this checkout,
# not shipped output and not portable between machines.
# .zvec-grep/ holds zvec-grep's semantic index over docs/ + architectural prose.
.zvec-grep/

# graphify-out/ holds a generated knowledge graph over this checkout: 5MB
# of machine-written JSON that rewrites tens of thousands of lines on every
# rebuild, and it needed a custom merge driver to survive two people
# touching it at once. Point a local graphify instance at the checkout
# instead of sharing the output.
graphify-out/

# Local agent tooling state, same class as .claude/ and docs/ above:
# per-machine, never shipped, not portable between checkouts.
.epiq/
.opencode/
.gate/
